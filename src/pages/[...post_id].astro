---
import { render } from "astro:content";
import Layout from "#layouts/Layout.astro";
import SharePanel from "../components/legacy/SharePanel.astro";
import Toc from "#components/Toc.astro";
import Time from "#components/Time.astro";
import { compare } from "#utils/datetime.js";
import toc from "#utils/toc.js";
import { getPosts } from "#utils/content.js";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts
		.map((post, index, posts) => ({ post: post, prev: posts[index - 1], next: posts[index + 1] }))
		.map(entry => ({
			params: { post_id: entry.post.id },
			props: { entry }
		}));
}

const { entry } = Astro.props;
const { post, prev, next } = entry;
const { data } = post;
const { Content, headings } = await render(post);
const showToc = data.showToc && headings && headings.length > 0;
const prevPage = prev ? `/${prev.id}` : undefined;
const nextPage = next ? `/${next.id}` : undefined;
const hasRecommendations = prevPage || nextPage;
const showUpdate = compare(data.update, data.date) !== 0;

const pageInfo = {
	title: data.title,
	url: Astro.url.pathname,
	source: post.filePath,
	type: data.type,
	published: data.date,
	updated: data.update,
	previous: prevPage,
	next: nextPage
};
---

<Layout {pageInfo} class="popout">
	<Fragment slot="hero">
		<div class="hero-body">
			<hgroup>
				<h1>{data.title}</h1>
				{data.tagline && <p>{data.tagline}</p>}
			</hgroup>
		</div>
		<div class="hero-footer">
			<small>Published on <Time date={data.date} /></small>{showUpdate && <small>Updated on <Time date={data.update} /></small>}
		</div>
		{showToc && <nav class="toc">
			<div class="toc-header">Table of Contents</div>
			<Toc headings={toc(headings)}/>
		</nav>}
	</Fragment>
	<article class="post">
		<Content/>
	</article>
	<Fragment slot="sidekick">
		<div class="sidekick-panels">
			<SharePanel {pageInfo}/>
		</div>

		{hasRecommendations && <ul class="rec">
			{prevPage &&
				<li class="rec-prev">
					<strong class="hint">Previous post</strong> &mdash; <a href={prevPage}>{prev.data.title}</a>
				</li>
			}
			{nextPage &&
				<li class="rec-next">
					<strong class="hint">Next post</strong> &mdash; <a href={nextPage}>{next.data.title}</a>
				</li>
			}
		</ul>}
	</Fragment>
</Layout>
