---
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Toc from "../components/legacy/Toc.astro";
import Time from "#components/Time.astro";
import format, { compare, formats } from "#mods/datetime/index.js";
import toc from "../modules/table-of-contents/index.js";
import siteInfo from "../modules/website/index.js";
import { getArchives } from "#utils/content.js";

export async function getStaticPaths() {
	const posts = await getArchives();
	return posts
		.map(post => ({
			params: { archive_id: post.id },
			props: { post }
		}));
}

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const url = Astro.url.pathname;
const showToc = data.showToc && headings && headings.length > 0;
const showUpdate = compare(data.update, data.date) !== 0;

const pageInfo = {
	title: `${data.title} (Archived)`,
	url,
	source: post.filePath,
	type: "article",
	published: format(data.date, formats.date),
	updated: showUpdate ? format(data.update, formats.date) : undefined
};
---

<Layout {pageInfo} class="popout">
	<Fragment slot="hero">
		<div class="hero-body">
			<hgroup>
				<h1>{data.title}</h1>
				{data.tagline && <p>{data.tagline}</p>}
			</hgroup>
		</div>
		<div class="hero-footer">
			<small>Published on <Time date={data.date} /></small>{showUpdate && <small>Updated on <Time date={data.update} /></small>}<small class={`chip chip-warn`}>Archived</small>
		</div>
		{showToc && <nav class="toc">
			<div class="toc-header">Table of Contents</div>
			<Toc headings={toc(headings, siteInfo.maxTocDepth)}/>
		</nav>}
	</Fragment>
	<article class="post">
		<Content/>
	</article>
</Layout>
