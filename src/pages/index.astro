---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/legacy/PostCard.astro";
import NoteCard from "../components/legacy/NoteCard.astro";
import Icon from "../components/legacy/Icon.astro";
import siteInfo, { paginationPathname } from "../modules/website/index.js";
import { PostType } from "#utils/schema.js";
import { getPosts } from "#utils/content.js";

const posts = (await getPosts())
	.slice(0, siteInfo.maxPageItems);

const pageInfo = {
	title: "Home",
	url: Astro.url.pathname
};
---

<Layout {pageInfo} class="popout feed">
	<div slot="hero" class="hero-body">
		<hgroup>
			<h1>Hi, I&CloseCurlyQuote;m Naiyer</h1>
			<p>Book lover, software engineer, and a fellow web wanderer</p>
		</hgroup>
	</div>
	{posts.map(entry => entry.data.category === PostType.note.id ? <NoteCard {entry} /> : <PostCard {entry} />)}
	<div slot="sidekick" class="sidekick-items">
		<a href={paginationPathname("posts", 2)} class="button-link"><Icon name="twist-right-up"/> more posts</a>
	</div>
</Layout>
