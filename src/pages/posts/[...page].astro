---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/legacy/PostCard.astro";
import NoteCard from "../../components/legacy/NoteCard.astro";
import Pagination from "../../components/legacy/Pagination.astro";
import siteInfo from "../../modules/website/index.js";
import { PostType } from "../../modules/schema/defs.js";
import { getPosts } from "#utils/content.js";

export async function getStaticPaths({ paginate }) {
	const posts = await getPosts();
	return paginate(posts, { pageSize: siteInfo.maxPageItems });
}

const { page } = Astro.props;
const pageInfo = {
	title: `Posts (Page ${page.currentPage})`,
	url: Astro.url.pathname,
	previous: page?.url?.prev,
	next: page?.url?.next
};
---

<Layout {pageInfo} class="popout feed">
	<div slot="hero" class="hero-body">
		<hgroup>
			<h1>Posts</h1>
			<p>{page.start + 1}&hellip;{page.end + 1} of {page.total} entries</p>
		</hgroup>
	</div>
	{page.data.map(entry => entry.data.type === PostType.note.id ? <NoteCard {entry} /> : <PostCard {entry} />)}
	<div slot="sidekick" class="sidekick-items">
		<Pagination currentPage={page.currentPage} totalPages={page.lastPage} base="posts"/>
	</div>
</Layout>
