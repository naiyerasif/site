---
import Time from "#components/Time.astro";

const { entry } = Astro.props;
const link = `/${entry.id}`;
---

<div class="card">
	<div class="card-meta">
		<Time date={entry.data.date} />
	</div>
	<div class="card-body">
		<div class="card-header">
			<a href={link}>{entry.data.title}</a>
		</div>
		{entry.data.tagline && <div class="card-tagline">{entry.data.tagline}</div>}
	</div>
</div>
