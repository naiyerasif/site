---
import Time from "#components/Time.astro";
import { PostType } from "#utils/schema.js";

const { entry } = Astro.props;
const link = `/${entry.id}`;
const { id, label } = PostType[entry.data.category];
---

<div class="card" data-post-type={id}>
	<div class="card-meta">
		<small class="chip chip-note">{label}</small>
		<Time date={entry.data.date} />
	</div>
	<div class="card-body">
		<div class="card-header">
			<a href={link}>{entry.data.title}</a>
		</div>
		{entry.data.tagline && <div class="card-tagline">{entry.data.tagline}</div>}
	</div>
</div>
