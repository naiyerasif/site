---
import Time from "#components/Time.astro";

const { entry } = Astro.props;
const link = `/${entry.id}`;
---

<div class="card">
	<Time date={entry.data.date} class="card-meta" />
	<div class="card-body">
		<a href={link} class="card-header">{entry.data.title}</a>
		{entry.data.tagline && <div class="card-tagline">{entry.data.tagline}</div>}
	</div>
</div>
