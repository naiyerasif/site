---
import Icon from "./Icon.astro";
import siteInfo from "#utils/website.js";
import { PageInfo } from "#utils/schema.js";

const shareInfo = PageInfo.parse(Astro.props.pageInfo);
const shareableTitle = encodeURI(shareInfo.title);
const mastodonHandle = encodeURI(siteInfo.author.presence.mastodon.id);

const shareVia = [
	{
		icon: "envelope",
		title: "Share via email",
		link: `mailto:?subject=${shareInfo.title}&body=Checkout this article I read! ${shareInfo.url}`
	},
	{
		icon: "mastodon",
		title: "Share on Mastodon",
		link: `https://share.joinmastodon.org/#text=${shareInfo.title}%20(by%20${mastodonHandle})%20-%20${shareInfo.url}`
	},
	{
		icon: "hackernews",
		title: "Submit to Hacker News",
		link: `https://news.ycombinator.com/submitlink?u=${shareInfo.url}&t=${shareableTitle}`
	},
	{
		icon: "linkedin",
		title: "Post on LinkedIn",
		link: `https://www.linkedin.com/sharing/share-offsite/?url=${shareInfo.url}`
	},
	{
		icon: "reddit",
		title: "Post on Reddit",
		link: `http://www.reddit.com/submit?url=${shareInfo.url}&title=${shareableTitle}`
	}
];
---

<div class="share-panel">
	<share-url><button type="button" aria-live="polite" aria-label="Share link" class="share-button"><Icon name="arrow-up-from-bracket"/></button></share-url>
	{shareVia.map(share => <a href={share.link} title={share.title} rel="noopener noreferrer" target="_blank"><Icon name={share.icon}/></a>)}
</div>

<script>
// @ts-nocheck
// source: https://github.com/NigelOToole/share-url/blob/89309ed6de9a4e7ee284177f1291b7160c5a6d8d/src/scripts/share-url-wc.js#L1
export class ShareUrl extends HTMLElement {
	static register(tagName = "share-url") {
		if ("customElements" in window && !customElements.get(tagName)) {
			customElements.define(tagName, this);
		}
	}

	constructor() {
		super();

		this.options = {
			selector: ".share-url",
			activeClass: "is-active",
			action: "share",
			url: document.location.href,
			title: document.title,
			textSelector: null,
			textLabel: "",
			textSuccess: "Shared"
		};
	}

	connectedCallback() {
		for (const item of this.getAttributeNames()) {
			let prop = this.#camelCase(item);
			let value = this.#checkBoolean(this.getAttribute(item));
			this.options[prop] = value;
		}

		this.button = this.querySelector("button");
		this.textElement = this.querySelector(this.options.textSelector);
		if (this.textElement === null) this.textElement = this.button;
		if (this.options.textLabel) this.textElement.innerText = this.options.textLabel;

		if (navigator[this.options.action]) {
			const { signal } = this.abortController = new AbortController();
			this.button.addEventListener("click", () => this.#shareEvent(), { signal });
		} else {
			this.hidden = true;
		}
	}

	disconnectedCallback() {
		if (this.abortController) {
			this.abortController.abort();
		}
	}

	async #shareEvent() {
		try {
			if (this.options.action === "share") {
				await navigator.share({ title: this.options.title, text: this.options.title, url: this.options.url });
			}

			if (this.options.action === "clipboard") {
				await navigator.clipboard.writeText(this.options.url);
			}

			this.button.classList.add(this.options.activeClass);
		} catch (error) {
			if (error.name !== "AbortError") console.error(error.name, error.message);
		}
	}

	#checkBoolean(string) {
		if (string.toLowerCase() === "true") return true;
		if (string.toLowerCase() === "false") return false;
		return string;
	}

	#camelCase(name, delim = "-") {
		const pattern = new RegExp((delim + "([a-z])"), "g");
		return name.replace(pattern, (match, capture) => capture.toUpperCase());
	}
}

ShareUrl.register();
</script>
