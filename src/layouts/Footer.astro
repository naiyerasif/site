---
import IconPack from "../components/legacy/IconPack.astro";
import BackToTop from "../components/legacy/BackToTop.astro";
import siteInfo from "#utils/website.js";

const authorInfo = siteInfo.author;
const authorPresence = authorInfo.presence;
const authorName = authorInfo.name;
const siteIssueUrl = siteInfo.issueBase;
const currentYear = (new Date()).getFullYear();
---

<footer class="footer">
	<div class="quicklinks">
		<ul>
			<li><strong>RSS</strong></li>
			<li><a href="/feed.xml">Posts</a></li>
			<li><a href="/all.xml">Firehose</a></li>
		</ul>
		<ul>
			<li><strong>Connect</strong></li>
			{Object.entries(authorPresence).map(([network, details]) => <li><a href={details.url} rel="nofollow noopener noreferrer">{details.title}</a></li>)}
		</ul>
		<ul>
			<li><strong>Site</strong></li>
			<li><a href="/privacy/">Privacy</a></li>
			<li><a href="/sitemap-index.xml">Sitemap</a></li>
			<li><a href={siteIssueUrl} rel="nofollow noopener noreferrer">Report an issue</a></li>
		</ul>
	</div>
	<div class="copyright">
		<p>&copy; 2018&mdash;{currentYear}, <a href="/about/">{authorName}</a></p>
		<BackToTop/>
	</div>
</footer>
<IconPack/>
